    },
    {
      "id": "value-propositions-content",
      "type": "text",
      "x": 570,
      "y": 146,
      "width": 260,
      "height": 420,
      "angle": 0,
      "strokeColor": "#3b0764",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "⚡ Instant Delivery\nส่งไฟล์ดิจิทัลทันทีหลังชำระเงิน\nนำไปใช้ได้รวดเร็ว\n\n🎯 One-Stop Service\nออกแบบ Custom ครบจบ ประสาน\nพาร์ทเนอร์ผลิตในที่เดียว\n\n🔧 High Flexibility\nปรับแต่งได้ตามความต้องการ\nและงบประมาณของลูกค้า\n\n🔄 Continuous Improvement\nอัปเดตเทมเพลตและระบบ\nตามเทรนด์ใหม่อยู่เสมอ",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 7,
      "versionNonce": 526845271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785768334227,
      "link": null,
      "locked": false,
      "index": "aA",
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "⚡ Instant Delivery\nส่งไฟล์ดิจิทัลทันทีหลังชำระเงิน\nนำไปใช้ได้รวดเร็ว\n\n🎯 One-Stop Service\nออกแบบ Custom ครบจบ ประสาน\nพาร์ทเนอร์ผลิตในที่เดียว\n\n🔧 High Flexibility\nปรับแต่งได้ตามความต้องการ\nและงบประมาณของลูกค้า\n\n🔄 Continuous Improvement\nอัปเดตเทมเพลตและระบบ\nตามเทรนด์ใหม่อยู่เสมอ",
      "autoResize": true,
